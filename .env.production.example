# Copy to .env on the server (next to docker-compose.yml) and fill in.
# Generate secrets with:  openssl rand -base64 32

# Public hostname. With no domain of your own, use the server's public IP with
# dashes on sslip.io, e.g. 129-213-10-42.sslip.io for IP 129.213.10.42.
DOMAIN=

AUTH_SECRET=
POSTGRES_PASSWORD=
SEED_ADMIN_EMAIL=admin@olongapo.gov.ph
SEED_ADMIN_PASSWORD=

# Optional, but without it the forecast strip and live temperature/humidity
# fall back to monthly averages.
OPENWEATHER_API_KEY=

POSTGRES_DB=project_handa
POSTGRES_USER=postgres
